[Unit]
Description=RL Analytics: eigen wedstrijden uit de inbox verwerken
After=network-online.target
Wants=network-online.target

[Service]
User=rlanalytics
Group=rlanalytics
WorkingDirectory=/srv/rl-analytics
Environment=PYTHONIOENCODING=utf-8 HOME=/srv/rl-analytics
ExecStart=/srv/rl-analytics/.venv/bin/python -u -m kern.eigen_watcher --naam "Sand ツ" --bron /var/lib/rl-analytics-inbox --verplaats
Restart=always
RestartSec=60
Slice=rl-analytics.slice
Nice=19
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/rl-analytics /var/lib/rl-analytics-inbox

[Install]
WantedBy=multi-user.target
